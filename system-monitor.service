[Unit]
Description=System Monitor Daemon — Slack Alerts
Documentation=https://github.com/yourrepo/system-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/system_monitor/monitor.py
Restart=always
RestartSec=10
StandardOutput=null
StandardError=null

# Resource limits — keep the daemon lean
CPUQuota=5%
MemoryMax=64M

[Install]
WantedBy=multi-user.target
